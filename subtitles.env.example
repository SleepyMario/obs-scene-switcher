# Install privately as ~/.config/obs-scene-switcher/subtitles.env (mode 0600).
STREAMCHAT_SUBTITLE_API_URL=http://10.77.0.1:8793
STREAMCHAT_BOT_GUI_PASSWORD=replace-with-the-existing-bot-gui-password
# Comma-separated Pulse/PipeWire source names are accepted. The first connected
# source is selected, allowing either wireless receiver to be used.
STREAMCHAT_SUBTITLE_SOURCE=alsa_input.usb-Shenzhen_Hollyland_Technology_Co._Ltd_Wireless_microphone_receiver-A-01.analog-stereo,alsa_input.usb-Shenzhen_Hollyland_Technology_Co._Ltd_Wireless_microphone_receiver-B-01.analog-stereo
