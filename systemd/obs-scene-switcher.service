[Unit]
Description=WireGuard-only OBS phone scene switcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/obs-scene-switcher/subtitles.env
ExecStart=%h/.local/bin/obs-scene-switcher --listen 10.77.0.2:8798
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=%h/.config/obs-studio/plugin_config/obs-websocket/config.json
ReadWritePaths=%h/.cache/language-subtitles

[Install]
WantedBy=default.target
