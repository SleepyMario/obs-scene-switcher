[Unit]
Description=OBS Studio launched from the phone controller
Requisite=graphical-session.target
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=exec
Environment=QT_QPA_PLATFORM=xcb QT_AUTO_SCREEN_SCALE_FACTOR=0 QT_ENABLE_HIGHDPI_SCALING=0 QT_SCALE_FACTOR=1 QT_FONT_DPI=96
ExecStartPre=%h/.local/bin/obs-scene-switcher --check-obs-launch
ExecStart=/usr/bin/obs --collection Main --scene "Starting Soon" --disable-missing-files-check
Restart=no
KillSignal=SIGINT
TimeoutStopSec=30
SendSIGKILL=no
