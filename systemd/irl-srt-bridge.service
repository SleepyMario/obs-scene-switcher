[Unit]
Description=IRL SRT to local OBS MPEG-TS bridge
After=network-online.target obs-scene-switcher.service
Wants=network-online.target obs-scene-switcher.service

[Service]
Type=simple
EnvironmentFile=%h/.config/irl-srt-bridge/env
ExecStart=%h/bin/irl-srt-bridge
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=default.target
